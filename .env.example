# Orion — Customer Intelligence Platform
# Groq is the primary live LLM provider. Keep the key server-side.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b


# Database
DATABASE_URL=sqlite:///data/orion.db

# Owner access, optional
ADMIN_API_TOKEN=

# ChromaDB

# App
APP_ENV=development
LOG_LEVEL=INFO

# Workspace capacity
MAX_WORKSPACES=25
MAX_DEMO_WORKSPACES=25
MAX_CONCURRENT_GENERATIONS=1
